  "item": [
    {
      "name": "1. Listar Ordens de Serviço (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code é 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Tempo de resposta é menor que 500ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});",
              "",
              "pm.test(\"Retorna um array de ordens\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"array\");",
              "    pm.expect(jsonData.length).to.be.above(0);",
              "});",
              "",
              "pm.test(\"Estrutura da OS contém numero, cliente, status e destino\", function () {",
              "    var primeiraOS = pm.response.json()[0];",
              "    pm.expect(primeiraOS).to.have.property(\"numero\");",
              "    pm.expect(primeiraOS).to.have.property(\"cliente\");",
              "    pm.expect(primeiraOS).to.have.property(\"status\");",
              "    pm.expect(primeiraOS).to.have.property(\"destino\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/ordens.json",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "ordens.json"
          ]
        },
        "description": "Retorna todas as ordens de serviço de transporte e manutenção industrial ativas."
      },
      "response": []
    },
